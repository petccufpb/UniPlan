generator kysely {
    provider            = "prisma-kysely"
    previewFeatures     = ["views"]
    output              = "./kysely"
    fileName            = "types.ts"
    decimalTypeOverride = "number"
    jsonTypeOverride    = "Record<string,any>"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model University {
    id           BigInt                 @id @default(autoincrement())
    name         String                 @db.VarChar(150)
    abbreviation String?                @db.VarChar(10)
    departments  UniversityDepartment[]
    curricula    UniversityCurriculum[]
    requests     UniversityRequest[]
    terms        UniversityTerm[]
}

model UniversityCourse {
    id           String                 @id @db.VarChar(15)
    title        String                 @db.VarChar(150)
    abbreviation String?                @db.VarChar(10)
    departmentId BigInt
    department   UniversityDepartment   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
    terms        UniversityTermCourse[]
}

model UniversityCurriculum {
    id           BigInt              @id @default(autoincrement())
    title        String              @db.VarChar(150)
    abbreviation String?             @db.VarChar(10)
    universityId BigInt
    university   University          @relation(fields: [universityId], references: [id], onDelete: Cascade)
    requests     UniversityRequest[]
}

model UniversityDepartment {
    id           BigInt             @id @default(autoincrement())
    universityId BigInt
    university   University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
    name         String             @db.VarChar(150)
    abbreviation String?            @db.VarChar(10)
    courses      UniversityCourse[]
}

model UniversityRequest {
    id           BigInt                @id @default(autoincrement())
    universityId BigInt?
    university   University?           @relation(fields: [universityId], references: [id], onDelete: Cascade)
    curriculumId BigInt?
    curriculum   UniversityCurriculum? @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
    title        String                @db.VarChar(150)
    content      String
    variables    Json                  @db.JsonB
}

model UniversityTerm {
    id           BigInt                 @id @default(autoincrement())
    universityId BigInt
    university   University             @relation(fields: [universityId], references: [id], onDelete: Cascade)
    name         String?                @db.VarChar(15)
    startDate    DateTime?              @db.Date
    endDate      DateTime?              @db.Date
    courses      UniversityTermCourse[]
}

model UniversityTermCourse {
    courseId   String           @db.VarChar(15)
    course     UniversityCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
    termId     BigInt
    term       UniversityTerm   @relation(fields: [termId], references: [id], onDelete: Cascade)
    timePeriod String?          @db.VarChar(10)
    whatsapp   String?          @db.VarChar(50)

    @@unique([courseId, termId])
}

model User {
    id String @id @default(cuid(2)) @db.VarChar(24)
}
