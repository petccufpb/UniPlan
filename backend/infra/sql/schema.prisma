generator kysely {
    provider            = "prisma-kysely"
    previewFeatures     = ["views"]
    output              = "./kysely"
    fileName            = "types.ts"
    decimalTypeOverride = "number"
    jsonTypeOverride    = "Record<string,any>"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model University {
    id          BigInt                 @id @default(autoincrement())
    name        String                 @db.VarChar(150)
    departments UniversityDepartment[]
    terms       UniversityTerm[]
}

model UniversityCourse {
    id           BigInt                 @id @default(autoincrement())
    title        String                 @db.VarChar(150)
    departmentId BigInt
    department   UniversityDepartment?  @relation(fields: [departmentId], references: [id])
    terms        UniversityTermCourse[]
}

model UniversityDepartment {
    id           BigInt             @id @default(autoincrement())
    universityId BigInt
    university   University         @relation(fields: [universityId], references: [id])
    name         String             @db.VarChar(150)
    courses      UniversityCourse[]
}

model UniversityTerm {
    id           BigInt                 @id @default(autoincrement())
    name         String                 @db.VarChar(15)
    universityId BigInt
    university   University             @relation(fields: [universityId], references: [id])
    courses      UniversityTermCourse[]
}

model UniversityTermCourse {
    courseId BigInt
    course   UniversityCourse @relation(fields: [courseId], references: [id])
    termId   BigInt
    term     UniversityTerm   @relation(fields: [termId], references: [id])
    whatsapp String?          @db.VarChar(50)

    @@unique([courseId, termId])
}

model User {
    id String @id @default(cuid(2)) @db.VarChar(24)
}
