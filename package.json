{
	"name": "uniplan",
	"private": true,
	"workspaces": ["backend", "frontend"],
	"scripts": {
		"format": "bun format:biome . & bun format:eslint .",
		"format:biome": "biome check --diagnostic-level=error --write --unsafe",
		"format:eslint": "eslint --quiet --fix",
		"format:backend": "bun format:biome ./backend && bun format:eslint ./backend",
		"format:frontend": "bun format:biome ./frontend/src && bun format:eslint ./frontend/**/*.ts",
		"prepare": "git config --local core.hooksPath .githooks"
	},
	"lint-staged": {
		"**/*.(css|graphql|js|jsx|json|jsonc|ts|tsx)": ["bun format:biome --no-errors-on-unmatched"],
		"**/*.(js|jsx|ts|tsx)": ["bun format:eslint"]
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@eslint/js": "^9.29.0",
		"@hyoretsu/tsconfig": "^1.0.4",
		"@types/bun": "^1.2.16",
		"@types/node": "^22.15.32",
		"eslint": "^9.29.0",
		"eslint-config-biome": "^1.9.4",
		"eslint-plugin-jest": "^28.14.0",
		"git-commit-msg-linter": "^5.0.8",
		"jiti": "^2.4.2",
		"lint-staged": "^16.1.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.34.1"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@parcel/watcher",
		"@prisma/engines",
		"esbuild",
		"git-commit-msg-linter",
		"prisma",
		"sharp"
	]
}
